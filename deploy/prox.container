[Unit]
Description=Prox management UI (separate upstream fork)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/prox:dev
ContainerName=prox
Network=host
# Baked routes and discovery are the default. Runtime hub discovery overlays them from a drop-in
# the operator adds (docs/PROX-SETUP.md, "Runtime hub discovery"); nothing is mounted here.

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

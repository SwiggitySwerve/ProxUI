[Unit]
Description=Prox management UI (separate upstream fork)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/prox:dev
ContainerName=prox
Network=host
# Runtime hub discovery (docs/PROX-SETUP.md): prox-sources-apply publishes the baked sources plus
# the admitted hubs into this directory, so the baked routes are masked; leaving them would repeat
# every location and Nginx would refuse to start. The directory is mounted, not its files, because
# a single-file mount keeps the old file after a rename. scripts/deploy-homelab.sh seeds it first.
Volume=/dev/null:/etc/nginx/provider-routes.conf:ro
Volume=%h/.local/share/prox/sources:/etc/nginx/runtime:ro

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
